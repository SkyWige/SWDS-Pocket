<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Swds" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/icon_bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>
    <style name="Theme.Swds.Sheet" parent="Theme.Swds" />
