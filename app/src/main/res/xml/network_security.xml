<?xml version="1.0" encoding="utf-8"?>
<!-- SWDS обычно работает в домашней сети по http://192.168.x.x — разрешаем незашифрованное соединение.
     Самоподписанный сертификат SWDS тоже принимается (пользовательские сертификаты). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
