<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp" android:paddingBottom="2dp">
    <ImageView android:id="@+id/rowbg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/row_btn_bg" android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:minHeight="44dp" android:paddingStart="8dp" android:paddingEnd="10dp"
        android:paddingTop="6dp" android:paddingBottom="6dp">
        <FrameLayout android:id="@+id/icon_box" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="10dp">
            <ImageView android:id="@+id/icon_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/chip_bg" android:scaleType="fitXY" android:contentDescription="@null" />
            <TextView android:id="@+id/icon" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:textSize="14sp" android:textColor="#0F172A" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/t" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="13.5sp" android:textColor="#0F172A" android:maxLines="2" android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11.5sp" android:textColor="#64748B" android:maxLines="1" android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/right" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#64748B" android:paddingStart="8dp" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
