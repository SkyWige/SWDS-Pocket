<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="2dp">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg" android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="5dp">
        <FrameLayout android:id="@+id/q_note" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="4dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/quick_note">
            <ImageView android:id="@+id/q_note_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/row_btn_bg" android:scaleType="fitXY" android:contentDescription="@null" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
                android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/q_note_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="26sp" android:text="📝" android:gravity="center" />
                <TextView android:id="@+id/q_note_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11.5sp" android:maxLines="1" android:text="@string/quick_note" android:paddingTop="2dp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/q_money" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="4dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/quick_expense">
            <ImageView android:id="@+id/q_money_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/row_btn_bg" android:scaleType="fitXY" android:contentDescription="@null" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
                android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/q_money_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="26sp" android:text="💸" android:gravity="center" />
                <TextView android:id="@+id/q_money_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11.5sp" android:maxLines="1" android:text="@string/quick_expense" android:paddingTop="2dp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
