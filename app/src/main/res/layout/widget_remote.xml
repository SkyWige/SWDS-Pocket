<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="2dp">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg" android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="5dp">
        <FrameLayout android:id="@+id/r_pc" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="4dp" android:clickable="true" android:focusable="true" android:contentDescription="Компьютер">
            <ImageView android:id="@+id/r_pc_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/row_btn_bg" android:scaleType="fitXY" android:contentDescription="@null" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
                android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/r_pc_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="24sp" android:text="💻" android:gravity="center" />
                <TextView android:id="@+id/r_pc_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11.5sp" android:maxLines="1" android:text="Компьютер" android:paddingTop="2dp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/r_phones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="4dp" android:clickable="true" android:focusable="true" android:contentDescription="Устройства">
            <ImageView android:id="@+id/r_phones_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/row_btn_bg" android:scaleType="fitXY" android:contentDescription="@null" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
                android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/r_phones_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="24sp" android:text="📲" android:gravity="center" />
                <TextView android:id="@+id/r_phones_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11.5sp" android:maxLines="1" android:text="Устройства" android:paddingTop="2dp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/r_share" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="4dp" android:clickable="true" android:focusable="true" android:contentDescription="Мой экран">
            <ImageView android:id="@+id/r_share_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/row_btn_bg" android:scaleType="fitXY" android:contentDescription="@null" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
                android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/r_share_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="24sp" android:text="📡" android:gravity="center" />
                <TextView android:id="@+id/r_share_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11.5sp" android:maxLines="1" android:text="Мой экран" android:paddingTop="2dp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
