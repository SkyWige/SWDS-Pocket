<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg" android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="6dp" android:paddingTop="6dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/h_title" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="22dp" android:textSize="13sp" android:textStyle="bold" android:gravity="center_vertical"
                android:textColor="#0F172A" android:maxLines="1" android:ellipsize="end" android:text="❤️ Здоровье" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="0.5sp" />
            <TextView android:id="@+id/h_updated" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#64748B" android:paddingEnd="4dp" />
            <TextView android:id="@+id/h_refresh" android:layout_width="30dp" android:layout_height="30dp"
                android:gravity="center" android:textSize="17sp" android:textColor="#64748B" android:text="⟳" />
        </LinearLayout>
        <LinearLayout android:id="@+id/h_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:id="@+id/h_ring_box" android:layout_width="86dp" android:layout_height="86dp">
                <ImageView android:id="@+id/h_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitCenter" android:contentDescription="@null" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/h_steps" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="19sp" android:textColor="#0F172A" android:text="—" android:maxLines="1" android:fontFamily="sans-serif-medium" />
                    <TextView android:id="@+id/h_steps_l" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="10sp" android:textColor="#64748B" android:text="шагов" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="8dp">
                <TextView android:id="@+id/h_l1" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="#0F172A" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/h_l2" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="#0F172A" android:maxLines="1" android:ellipsize="end" android:paddingTop="3dp" />
                <TextView android:id="@+id/h_l3" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="#0F172A" android:maxLines="1" android:ellipsize="end" android:paddingTop="3dp" />
                <TextView android:id="@+id/h_l4" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#64748B" android:maxLines="2" android:ellipsize="end" android:paddingTop="3dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
